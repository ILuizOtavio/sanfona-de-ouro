# ──────────────────────────────────────────────────────────────────
#  Sanfona de Ouro — variáveis de ambiente
#  Copie este arquivo para .env e preencha com seus dados do Supabase
# ──────────────────────────────────────────────────────────────────

# Cole a URL do seu projeto Supabase (Settings > API > Project URL)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Cole a chave anon pública (Settings > API > anon public)
VITE_SUPABASE_ANON_KEY=sua-chave-anon-aqui

